<?xml version="1.0" encoding="utf-8"?>
<!-- Service d'accessibilité limité aux Réglages : rebranche l'accès aux notifications de xDrip+. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="300"
    android:packageNames="com.android.settings" />
